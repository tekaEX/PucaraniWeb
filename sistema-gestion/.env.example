# Copia este archivo como ".env.local" y completa con los datos de tu proyecto Supabase.
# En Supabase: Project Settings -> Data API / API Keys

# URL del proyecto (ej. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (publishable). Es segura para el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Integración SII (SimpleAPI) ---
# Master Key de SimpleAPI (identifica tu app; va en el header Authorization).
SIMPLEAPI_KEY=

# Llave para cifrar la contraseña del certificado digital (AES-256-GCM).
# 32 bytes en hexadecimal (64 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Token PÚBLICO de Mapbox para el mapa y la navegación del conductor.
# Se obtiene en account.mapbox.com. Empieza con "pk." y viaja al navegador por
# diseño: restringirlo por URL en el panel de Mapbox.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Integración WhatsApp Business (Meta Cloud API) ---
# String que tú inventas; debe coincidir con "Token de verificación" en
# Meta > WhatsApp > Configuración > Webhooks.
WHATSAPP_VERIFY_TOKEN=
# Datos de Meta > WhatsApp > Introducción rápida (token permanente más adelante).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
